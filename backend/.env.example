# Copy to backend/.env and fill in real values. Never commit the filled file.

# development | production
ENV=development

# CORS allowlist. Comma-separated origins, never "*" in production.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# SQLite location. In Docker the compose file overrides this to /app/data/digital_bridge.db.
# DB_PATH=./digital_bridge.db

# Session and verification lifetimes
SESSION_TTL_DAYS=7
OTP_TTL_MINUTES=15
OTP_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5
VERIFICATION_TTL_MINUTES=30

# Request limits
MAX_BODY_BYTES=8388608
MAX_AUDIO_BYTES=5242880

# Enable /docs and /openapi.json. Defaults to true outside production.
# ENABLE_DOCS=true

# Set to true only when a trusted reverse proxy sets X-Forwarded-For.
TRUST_PROXY=false

# Optional integrations
# ADDIS_API_KEY=
# HUGGINGFACE_API_KEY=
# SMS_WEBHOOK_URL=
# PARTNER_API_KEY=

LOG_LEVEL=INFO
